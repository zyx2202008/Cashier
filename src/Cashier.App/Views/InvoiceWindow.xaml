<Window x:Class="Cashier.App.Views.InvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发票登记" Width="680" Height="680" MinHeight="420" MinWidth="600" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" Background="{StaticResource B.Bg}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="InvoiceScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Style="{StaticResource Card}" Padding="16,14">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock x:Name="TitleText" Text="登记发票" Style="{StaticResource T.H1}"/>
          <Border Style="{StaticResource Chip}" Margin="10,0,0,0">
            <TextBlock x:Name="KindText" Text="销项" FontSize="11" Foreground="{StaticResource B.Ink2}"/>
          </Border>
        </StackPanel>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="发票类型 *" Style="{StaticResource T.Label}"/>
            <ComboBox x:Name="CmbType" DisplayMemberPath="Name"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock Text="发票号码 *" Style="{StaticResource T.Label}"/>
            <TextBox x:Name="TxtNo" Height="30"/>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="发票代码（全电发票可留空）" Style="{StaticResource T.Label}"/>
            <TextBox x:Name="TxtCode" Height="30"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock x:Name="LblPartner" Text="客户 *" Style="{StaticResource T.Label}"/>
            <DockPanel>
              <Button x:Name="BtnAddCustomer" DockPanel.Dock="Right" Content="新增客户" Click="AddCustomer_Click"
                      Margin="6,0,0,0" Padding="8,0" ToolTipService.ShowOnDisabled="True"/>
              <ComboBox x:Name="CmbPartner" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Partner_Changed"/>
            </DockPanel>
          </StackPanel>

          <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="登记日期 *" Style="{StaticResource T.Label}"/>
            <DatePicker x:Name="DpReg" SelectedDateFormat="Short"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock Text="交票日期" Style="{StaticResource T.Label}"/>
            <DatePicker x:Name="DpDeliver" SelectedDateFormat="Short"/>
          </StackPanel>

          <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,10">
            <TextBlock Text="含税金额（价税合计）*" Style="{StaticResource T.Label}"/>
            <TextBox x:Name="TxtGross" Height="30" TextChanged="Amount_Changed"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
            <TextBlock Text="税率（%）" Style="{StaticResource T.Label}"/>
            <ComboBox x:Name="CmbRate" IsEditable="True" SelectionChanged="Rate_Changed" LostFocus="Rate_LostFocus"/>
          </StackPanel>
        </Grid>

        <Border x:Name="QuickCustomerPanel" Visibility="Collapsed" BorderBrush="{StaticResource B.Line}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12"
                KeyboardNavigation.TabNavigation="Cycle">
          <StackPanel>
            <TextBlock Text="快捷新增客户" Style="{StaticResource T.Label}"/>
            <StackPanel x:Name="QuickCustomerFields">
              <TextBlock Text="客户名称 *" Style="{StaticResource T.Label}" Margin="0,8,0,0"/>
              <TextBox x:Name="TxtQuickName" MaxLength="200" Height="30" TextChanged="QuickName_Changed"/>
              <TextBlock Text="客户编码：保存时自动分配（KH-0001…）" Style="{StaticResource T.Hint}" Margin="0,5,0,6"/>
              <Expander Header="联系人、电话和地址（选填）">
                <StackPanel Margin="0,8,0,0">
                  <TextBlock Text="联系人" Style="{StaticResource T.Label}"/>
                  <TextBox x:Name="TxtQuickContact" MaxLength="100" Height="30"/>
                  <TextBlock Text="电话（可含区号、分机）" Style="{StaticResource T.Label}" Margin="0,6,0,0"/>
                  <TextBox x:Name="TxtQuickPhone" MaxLength="100" Height="30"/>
                  <TextBlock Text="地址" Style="{StaticResource T.Label}" Margin="0,6,0,0"/>
                  <TextBox x:Name="TxtQuickAddress" MaxLength="500" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                </StackPanel>
              </Expander>
            </StackPanel>
            <TextBlock Text="保存后客户将加入名录；取消本张发票不会删除已保存的客户。" Style="{StaticResource T.Hint}"
                       TextWrapping="Wrap" Margin="0,8,0,8"/>
            <TextBlock x:Name="QuickMessage" TextWrapping="Wrap" Foreground="#B45309" Margin="0,0,0,6"/>
            <StackPanel x:Name="DuplicatePanel" Visibility="Collapsed" Margin="0,0,0,8">
              <TextBlock Text="发现同名单位。请选定具体的启用客户，或确认同名不同单位。" TextWrapping="Wrap" Style="{StaticResource T.Hint}"/>
              <ListBox x:Name="DuplicateCandidates" MaxHeight="160" Margin="0,6,0,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button x:Name="BtnUseExisting" Content="选用已有客户" Click="UseExisting_Click" Margin="0,0,6,6"/>
                <Button x:Name="BtnConfirmDuplicate" Content="同名不同单位，继续新增" Click="ConfirmDuplicate_Click" Margin="0,0,0,6"/>
              </WrapPanel>
            </StackPanel>
            <WrapPanel>
              <Button x:Name="BtnSaveQuickCustomer" Content="保存客户并选用" Click="SaveQuickCustomer_Click" Style="{StaticResource Btn.Primary}" Margin="0,0,8,4"/>
              <Button x:Name="BtnCancelQuickCustomer" Content="取消新增" Click="CancelQuickCustomer_Click" Margin="0,0,0,4"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <TextBlock x:Name="CustomerSavedMessage" Visibility="Collapsed" Foreground="{StaticResource B.BrandDark}"
                   Text="客户已保存并选用，发票尚未保存" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="不含税金额（可按票面修改）" Style="{StaticResource T.Label}"/>
            <TextBox x:Name="TxtNet" Height="30"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="税额（可按票面修改）" Style="{StaticResource T.Label}"/>
            <TextBox x:Name="TxtTax" Height="30"/>
          </StackPanel>
        </Grid>

        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="红字原发票（负金额必选）" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbOriginal" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,10">
          <TextBlock Text="发票内容" Style="{StaticResource T.Label}"/>
          <TextBox x:Name="TxtContent" Height="30"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="备注" Style="{StaticResource T.Label}"/>
          <TextBox x:Name="TxtNote" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8,6"/>
        </StackPanel>

        <TextBlock x:Name="HintText" Style="{StaticResource T.Hint}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="输入含税金额和税率后自动计算，可按票面修改；红字使用负金额并选择原发票。不含税金额 + 税额必须等于含税金额。"/>
      </StackPanel>
    </Border>
    </ScrollViewer>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Width="84" Click="Cancel_Click" Margin="0,0,8,0"/>
        <Button x:Name="BtnSaveInvoice" Content="保存" Width="96" Style="{StaticResource Btn.Primary}" Click="Save_Click" IsDefault="True"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
