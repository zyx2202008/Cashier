<UserControl x:Class="Cashier.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Bg}">
  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" x:Name="FilterCard" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel x:Name="BoxDateRange" Margin="0,0,10,8">
          <TextBlock Text="统计期间" Style="{StaticResource T.Label}"/>
          <StackPanel Orientation="Horizontal">
            <DatePicker x:Name="DateFrom" Width="126" SelectedDateFormat="Short" SelectedDateChanged="Date_Changed"/>
            <TextBlock Text="~" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource B.Ink3}"/>
            <DatePicker x:Name="DateTo" Width="126" SelectedDateFormat="Short" SelectedDateChanged="Date_Changed"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="BoxYear" Margin="0,0,10,8" Width="90" Visibility="Collapsed">
          <TextBlock Text="选择年度" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbYear"/>
        </StackPanel>
        <StackPanel x:Name="BoxMonth" Margin="0,0,10,8" Width="75" Visibility="Collapsed">
          <TextBlock Text="选择月份" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbMonth"/>
        </StackPanel>
        <StackPanel x:Name="BoxDirection" Margin="0,0,10,8" Width="96" Visibility="Collapsed">
          <TextBlock Text="发票方向" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbDirection" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Direction_Changed"/>
        </StackPanel>
        <StackPanel x:Name="BoxPartner" Margin="0,0,10,8" Width="170">
          <TextBlock x:Name="PartnerFilterLabel" Text="往来单位" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbPartner" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>
        <StackPanel x:Name="BoxProject" Margin="0,0,10,8" Width="170">
          <TextBlock Text="项目" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbProject" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>
        <StackPanel x:Name="BoxAccount" Margin="0,0,10,8" Width="170">
          <TextBlock Text="账户" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbAccount" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        </StackPanel>
        <StackPanel x:Name="BoxQuick" Margin="0,0,10,8" Width="112" Visibility="Collapsed">
          <TextBlock Text="快捷期间" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbQuick" SelectionChanged="QuickPeriod_Changed"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
          <Button x:Name="QueryButton" Content="查询" Style="{StaticResource Btn.Primary}" Click="Query_Click" Margin="0,0,6,0"/>
          <StackPanel x:Name="BoxQuickButtons" Orientation="Horizontal">
            <Button Content="本月" Style="{StaticResource Btn.Sm}" Click="Quick_Click" Tag="month" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <Button Content="本年" Style="{StaticResource Btn.Sm}" Click="Quick_Click" Tag="year" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
      </WrapPanel>
    </Border>

    <Border Grid.Row="1" x:Name="BasisCard" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock x:Name="BasisText" Style="{StaticResource T.Muted}" TextWrapping="Wrap"/>
        <TextBlock x:Name="NoteText" Style="{StaticResource T.Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" x:Name="TableCard" Style="{StaticResource Card}" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" x:Name="Grid" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick"
                  CanUserSortColumns="False"/>
        <Border Grid.Row="1" x:Name="FootPanel" Background="#FBFCFD" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="12,7">
          <StackPanel>
            <TextBlock x:Name="FootCount" Style="{StaticResource T.Muted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="FootTotal" Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
