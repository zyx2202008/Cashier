<Window x:Class="Cashier.App.Views.InvoiceLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发票关联业务" Width="880" Height="640" WindowStartupLocation="CenterOwner"
        Background="{StaticResource B.Bg}" FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="TitleText" Text="关联业务" Style="{StaticResource T.H1}"/>
          <Border Style="{StaticResource Chip}" Margin="10,0,0,0">
            <TextBlock x:Name="KindText" Text="" FontSize="11" Foreground="{StaticResource B.Ink2}"/>
          </Border>
        </StackPanel>
        <TextBlock x:Name="InfoText" Style="{StaticResource T.Muted}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="1" Text="可关联业务（同往来单位、已审核、可开票）" Style="{StaticResource T.Muted}" Margin="2,10,0,6"/>

    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
      <DataGrid x:Name="GridBiz" IsReadOnly="True"/>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="关联金额" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox x:Name="TxtAmount" Width="140" Height="30"/>
        <Button Content="关联到选中业务" Style="{StaticResource Btn.Primary}" Margin="10,0,0,0" Click="Link_Click"/>
        <TextBlock x:Name="TipText" Style="{StaticResource T.Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="已关联业务" Style="{StaticResource T.Muted}" Margin="2,0,0,6"/>
        <Border Style="{StaticResource Card}" Height="140" ClipToBounds="True">
          <DataGrid x:Name="GridLinks" IsReadOnly="True"/>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,8">
        <Button Content="解除选中关联" Style="{StaticResource Btn.Danger}" Width="112" Click="Unlink_Click"/>
        <Button Content="关闭" Width="112" Margin="0,8,0,0" Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
