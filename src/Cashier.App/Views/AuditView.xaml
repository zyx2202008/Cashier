<UserControl x:Class="Cashier.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Bg}">
  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10,10,10,2" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Margin="0,0,8,8" Width="140">
          <TextBlock Text="单据类型" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbKind">
            <ComboBoxItem Content="全部" IsSelected="True"/>
            <ComboBoxItem Content="收入"/>
            <ComboBoxItem Content="支出"/>
            <ComboBoxItem Content="应收"/>
            <ComboBoxItem Content="应付"/>
            <ComboBoxItem Content="内部转账"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Margin="0,0,8,8" Width="200">
          <TextBlock Text="关键字" Style="{StaticResource T.Label}"/>
          <TextBox x:Name="TxtKeyword" Height="30"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
          <Button Content="查询" Style="{StaticResource Btn.Primary}" Click="Query_Click" Margin="0,0,6,0"/>
          <Button Content="批量审核选中" Click="BatchAudit_Click"/>
        </StackPanel>
        <TextBlock x:Name="HintText" Style="{StaticResource T.Hint}" VerticalAlignment="Bottom" Margin="12,0,0,10"
                   Text="待审核单据不计入正式账务与报表，审核后才过账。"/>
      </WrapPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" x:Name="Grid" IsReadOnly="True" SelectionMode="Extended"/>
        <Border Grid.Row="1" Background="#FBFCFD" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="12,7">
          <TextBlock x:Name="FootText" Style="{StaticResource T.Muted}"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
