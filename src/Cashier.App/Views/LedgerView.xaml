<UserControl x:Class="Cashier.App.Views.LedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Bg}">
  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 指标条 -->
    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="4,9" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="16,0,26,0">
          <TextBlock x:Name="MetricInLabel" Text="本期收入" Style="{StaticResource T.Muted}"/>
          <TextBlock x:Name="MetricIn" Text="0.00" Style="{StaticResource T.Metric}" Foreground="{StaticResource B.Pos}"/>
          <TextBlock x:Name="MetricInSub" Text="" Style="{StaticResource T.Hint}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,26,0">
          <TextBlock x:Name="MetricOutLabel" Text="本期支出" Style="{StaticResource T.Muted}"/>
          <TextBlock x:Name="MetricOut" Text="0.00" Style="{StaticResource T.Metric}" Foreground="{StaticResource B.Neg}"/>
          <TextBlock x:Name="MetricOutSub" Text="" Style="{StaticResource T.Hint}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock x:Name="MetricNetLabel" Text="本期净额" Style="{StaticResource T.Muted}"/>
          <TextBlock x:Name="MetricNet" Text="0.00" Style="{StaticResource T.Metric}" Foreground="{StaticResource B.Brand}"/>
          <TextBlock x:Name="NetSubText" Text="资金口径 · 不含内部转账" Style="{StaticResource T.Hint}"/>
        </StackPanel>
        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="RangeText" Text="" Style="{StaticResource T.Muted}" HorizontalAlignment="Right"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="本月" Style="{StaticResource Btn.Sm}" Click="Quick_Click" Tag="month" Margin="0,0,4,0"/>
            <Button Content="上月" Style="{StaticResource Btn.Sm}" Click="Quick_Click" Tag="last" Margin="0,0,4,0"/>
            <Button Content="本季" Style="{StaticResource Btn.Sm}" Click="Quick_Click" Tag="quarter" Margin="0,0,4,0"/>
            <Button Content="本年" Style="{StaticResource Btn.Sm}" Click="Quick_Click" Tag="year"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 筛选 -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,10,10,2" Margin="0,0,0,10">
      <WrapPanel Orientation="Horizontal">
        <StackPanel Margin="0,0,8,8">
          <TextBlock Text="日期范围" Style="{StaticResource T.Label}"/>
          <StackPanel Orientation="Horizontal">
            <DatePicker x:Name="DateFrom" Width="124" SelectedDateFormat="Short"/>
            <TextBlock Text="~" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource B.Ink3}"/>
            <DatePicker x:Name="DateTo" Width="124" SelectedDateFormat="Short"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="BoxAccount" Margin="0,0,8,8" Width="150">
          <TextBlock Text="账户" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbAccount" DisplayMemberPath="Name"/>
        </StackPanel>
        <StackPanel x:Name="BoxPartner" Margin="0,0,8,8" Width="170">
          <TextBlock Text="往来单位" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbPartner" DisplayMemberPath="Name"/>
        </StackPanel>
        <StackPanel x:Name="BoxStatus" Margin="0,0,8,8" Width="118">
          <TextBlock Text="状态" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbStatus">
            <ComboBoxItem Content="全部" IsSelected="True"/>
            <ComboBoxItem Content="草稿"/>
            <ComboBoxItem Content="待审核"/>
            <ComboBoxItem Content="已审核"/>
            <ComboBoxItem Content="已作废"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Margin="0,0,8,8" Width="180">
          <TextBlock Text="关键字" Style="{StaticResource T.Label}"/>
          <TextBox x:Name="TxtKeyword" Height="30" KeyDown="TxtKeyword_KeyDown"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
          <Button Content="查询" Style="{StaticResource Btn.Primary}" Click="Query_Click" Margin="0,0,6,0"/>
          <Button Content="重置" Click="Reset_Click"/>
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- 表格 -->
    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" x:Name="Grid" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick"
                  SelectionChanged="Grid_SelectionChanged" BorderThickness="0"/>
        <Border Grid.Row="1" Background="#FBFCFD" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="12,7">
          <StackPanel>
            <TextBlock x:Name="FootCount" Style="{StaticResource T.Muted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="FootSum" Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
