<UserControl x:Class="Cashier.App.Views.InvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Bg}">
  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="4,9" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="16,0,26,0">
          <TextBlock Text="价税合计" Style="{StaticResource T.Muted}"/>
          <TextBlock x:Name="MetricGross" Text="0.00" Style="{StaticResource T.Metric}"/>
          <TextBlock x:Name="MetricGrossSub" Text="" Style="{StaticResource T.Hint}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,26,0">
          <TextBlock Text="不含税金额" Style="{StaticResource T.Muted}"/>
          <TextBlock x:Name="MetricNet" Text="0.00" Style="{StaticResource T.Metric}"/>
          <TextBlock x:Name="MetricNetSub" Text="" Style="{StaticResource T.Hint}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="税额" Style="{StaticResource T.Muted}"/>
          <TextBlock x:Name="MetricTax" Text="0.00" Style="{StaticResource T.Metric}"/>
          <TextBlock x:Name="MetricTaxSub" Text="" Style="{StaticResource T.Hint}"/>
        </StackPanel>
        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock x:Name="RangeText" Text="" Style="{StaticResource T.Muted}" HorizontalAlignment="Right"/>
          <TextBlock Text="发票登记不改变资金余额，仅用于开票台账与关联" Style="{StaticResource T.Hint}"
                     HorizontalAlignment="Right" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,10,10,2" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Margin="0,0,8,8">
          <TextBlock Text="登记日期" Style="{StaticResource T.Label}"/>
          <StackPanel Orientation="Horizontal">
            <DatePicker x:Name="DateFrom" Width="124" SelectedDateFormat="Short"/>
            <TextBlock Text="~" Margin="6,0" VerticalAlignment="Center" Foreground="{StaticResource B.Ink3}"/>
            <DatePicker x:Name="DateTo" Width="124" SelectedDateFormat="Short"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Margin="0,0,8,8" Width="180">
          <TextBlock Text="往来单位" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbPartner" DisplayMemberPath="Name"/>
        </StackPanel>
        <StackPanel Margin="0,0,8,8" Width="112">
          <TextBlock Text="状态" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbStatus">
            <ComboBoxItem Content="全部" IsSelected="True"/>
            <ComboBoxItem Content="有效"/>
            <ComboBoxItem Content="已作废"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Margin="0,0,8,8" Width="190">
          <TextBlock Text="关键字" Style="{StaticResource T.Label}"/>
          <TextBox x:Name="TxtKeyword" Height="30" KeyDown="TxtKeyword_KeyDown"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
          <Button Content="查询" Style="{StaticResource Btn.Primary}" Click="Query_Click" Margin="0,0,6,0"/>
          <Button Content="重置" Click="Reset_Click"/>
        </StackPanel>
      </WrapPanel>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" x:Name="Grid" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick"/>
        <Border Grid.Row="1" Background="#FBFCFD" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="12,7">
          <TextBlock x:Name="FootText" Style="{StaticResource T.Muted}" TextWrapping="Wrap"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
