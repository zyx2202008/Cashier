<Window x:Class="Cashier.App.Views.PeriodInvoiceCashDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="期间开票与收款明细" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource B.Bg}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="45*"/>
      <RowDefinition Height="55*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="TitleText" Text="期间开票与收款明细" Style="{StaticResource T.H1}"/>
          <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ChipText" Text="销项" FontSize="11" Foreground="{StaticResource B.Ink2}"/>
          </Border>
        </StackPanel>
        <TextBlock x:Name="PartnerText" Style="{StaticResource T.Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="SummaryText" Style="{StaticResource T.Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FBFCFD" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="12,7">
          <DockPanel>
            <TextBlock x:Name="InvoiceSectionText" DockPanel.Dock="Right" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
            <TextBlock Text="发票明细" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <DataGrid Grid.Row="1" x:Name="InvoiceGrid" IsReadOnly="True" CanUserSortColumns="False"/>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FBFCFD" BorderBrush="{StaticResource B.Line}" BorderThickness="0,0,0,1" Padding="12,7">
          <DockPanel>
            <TextBlock x:Name="CashSectionText" DockPanel.Dock="Right" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="CashSectionTitle" Text="收款明细" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>
        <DataGrid Grid.Row="1" x:Name="CashGrid" IsReadOnly="True" CanUserSortColumns="False"/>
      </Grid>
    </Border>

    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="导出 Excel" Style="{StaticResource Btn.Primary}" Click="Export_Click" Margin="0,0,8,0"/>
        <Button Content="关闭" Width="84" Click="Close_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
