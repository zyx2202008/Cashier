<UserControl x:Class="Cashier.App.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource B.Bg}">
  <Grid Margin="14,12,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10,10,10,2" Margin="0,0,0,10">
      <WrapPanel>
        <StackPanel Margin="0,0,8,8" Width="200">
          <TextBlock Text="关键字" Style="{StaticResource T.Label}"/>
          <TextBox x:Name="TxtKeyword" Height="30" KeyDown="TxtKeyword_KeyDown"/>
        </StackPanel>
        <StackPanel Margin="0,0,8,8" Width="120">
          <TextBlock Text="状态" Style="{StaticResource T.Label}"/>
          <ComboBox x:Name="CmbActive">
            <ComboBoxItem Content="全部" IsSelected="True"/>
            <ComboBoxItem Content="启用"/>
            <ComboBoxItem Content="停用"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
          <Button Content="查询" Style="{StaticResource Btn.Primary}" Click="Query_Click" Margin="0,0,6,0"/>
          <Button Content="重置" Click="Reset_Click"/>
        </StackPanel>
        <TextBlock x:Name="HintText" Style="{StaticResource T.Hint}" TextWrapping="Wrap" MaxWidth="330" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
      </WrapPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" x:Name="Grid" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick"/>
        <Border Grid.Row="1" Background="#FBFCFD" BorderBrush="{StaticResource B.Line}" BorderThickness="0,1,0,0" Padding="12,7">
          <TextBlock x:Name="FootText" Style="{StaticResource T.Muted}" TextWrapping="Wrap"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
